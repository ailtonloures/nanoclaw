{"nodes": [{"id": "readme_nanoclaw_overview", "label": "NanoClaw README (project overview)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_why_i_built_nanoclaw", "label": "Why I Built NanoClaw", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenClaw is impressive but too complex to trust with full life access \u2014 ~500k LOC, 53 config files, 70+ deps, app-level security (allowlists/pairing codes) rather than OS-level isolation, all in one Node process with shared memory. NanoClaw provides the same core functionality in a codebase small enough to understand, with agents in their own Linux containers for filesystem isolation."}, {"id": "readme_quick_start", "label": "NanoClaw Quick Start (nanoclaw.sh)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migrating_v1_to_v2", "label": "Migrating from NanoClaw v1 (migrate-v2.sh)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_philosophy", "label": "NanoClaw Philosophy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small enough to understand; secure by isolation (containers, mounts only); built for the individual user (bespoke forks, not a monolithic framework); customization = code changes, no config sprawl; AI-native hybrid design (scripted install + Claude Code handoff on judgment calls); skills over features (trunk is registry+infra, channels/providers on branches); best harness/best model (native Claude Agent SDK, drop-in other providers)."}, {"id": "readme_what_it_supports", "label": "What NanoClaw Supports (feature list)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_usage_examples", "label": "NanoClaw Usage Examples (@Andy trigger)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_customizing_section", "label": "Customizing NanoClaw (README section)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_contributing_section", "label": "Contributing (README section) \u2014 Don't add features, add skills", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rfs", "label": "RFS (Request for Skills)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_requirements_list", "label": "NanoClaw Requirements (macOS/Linux/WSL2, Node, pnpm, Docker, Claude Code)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_architecture_summary", "label": "NanoClaw Architecture Summary (README)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_faq", "label": "NanoClaw FAQ", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_uninstall"