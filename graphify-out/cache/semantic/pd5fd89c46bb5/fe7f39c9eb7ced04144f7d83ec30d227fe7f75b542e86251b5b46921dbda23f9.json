{"nodes": [{"id": "contributing_before_you_start", "label": "Before You Start Checklist", "file_type": "document", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_source_code_changes", "label": "Source Code Changes Policy", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted: bug fixes, security fixes, simplifications, reducing code. Not accepted: features/capabilities/compatibility/enhancements \u2014 those should be skills, to keep trunk minimal and every fork lean."}, {"id": "contributing_breaking_changes_policy", "label": "Breaking Changes Policy", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NanoClaw does not migrate user installs at runtime \u2014 the user's coding agent is the migrator, so every breaking change must ship a migration path (skill or docs/ page with detect/why/fix/verify/rollback) that agent can execute without a human reverse-engineering the diff."}, {"id": "contributing_versions_json", "label": "versions.json pin file", "file_type": "code", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_skills_overview", "label": "Why Skills (Contributing)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every user should have clean and minimal code that does exactly what they need. Skills let users selectively add features to their fork without inheriting code for features they don't want. A fork tracks its customizations as a recipe of skills, which keeps upgrades cheap."}, {"id": "contributing_channel_provider_skills", "label": "Channel and Provider Skills (registry branches)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_utility_skills", "label": "Utility Skills (with code files)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_operational_skills", "label": "Operational Skills (instruction-only)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_container_skills", "label": "Container Skills (agent runtime)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_skill_md_format", "label": "SKILL.md Format Rules", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_templates_repo", "label": "nanocoai/nanoclaw-templates repo", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_pr_hygiene", "label": "Pull Request Guidelines", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "contributing_before_you_start", "target": "readme_philosophy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTRIBUTING.md", "source_location": null, "weight": 1.0}, {"source": "cont